{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build lesson",
            "group": { "kind": "build", "isDefault": true },
            "type": "shell",
            "command": "make",
            "args": ["LESSON=${input:lesson}"],
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Flash lesson",
            "group": "build",
            "type": "shell",
            "command": "make",
            "args": ["LESSON=${input:lesson}", "flash"],
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "make",
            "args": ["clean"]
        }
    ],
    "inputs": [
        {
            "id": "lesson",
            "type": "pickString",
            "description": "Lesson to build",
            "options": [
                "01-boot",
                "02-gpio-seven-segment",
                "03-interrupts",
                "04-system-calls",
                "05-scheduling",
                "06-synchronization"
            ],
            "default": "01-boot"
        }
    ]
}
